# Copy to .env and fill in. .env is git-ignored and must never be committed (REQ-NFR-04).

# Primary LLM + embeddings
OPENAI_API_KEY=

# Fallback LLM + LLM-as-judge (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Backup market data (free key: https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=

# Optional overrides of config.yaml (nested keys use "__"), e.g.:
# APP__LOG_FORMAT=json
# LLM__ROLES__AGENT__MODEL=gpt-4.1
